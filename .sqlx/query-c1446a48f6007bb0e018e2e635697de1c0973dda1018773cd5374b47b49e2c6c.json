{
  "db_name": "MySQL",
  "query": "\n            SELECT \n                s.nis,\n                u.name AS nama,\n                k.nama AS kelas,\n                s.tingkat,\n                b.tempat_lahir,\n                DATE_FORMAT(b.tanggal_lahir, '%Y-%m-%d') AS tanggal_lahir,\n                b.nama_ayah,\n                b.nama_ibu,\n                b.alamat_lengkap,\n                b.telepon\n            FROM siswas s\n            JOIN kelas k ON k.id = s.kelas_id\n            JOIN users u ON u.nis = s.nis\n            LEFT JOIN biodatas b ON b.nis = s.nis\n            WHERE s.tahun = ?\n              AND s.kelas_id = ?\n              AND u.name LIKE ?\n            ORDER BY k.tingkat, k.nama, u.name\n            LIMIT ? OFFSET ?\n            ",
